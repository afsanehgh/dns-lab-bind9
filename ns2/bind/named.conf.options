acl "trusted" {
    10.128.10.11;     # ns1
    10.128.20.12;     # ns2
    10.128.100.101;   # host1
    10.128.200.102;   # host2
};

options {
    directory "/var/cache/bind";

    recursion yes;                  # enables recursive queries
    allow-recursion { trusted; };   # only trusted clients may use recursion

    listen-on { 10.128.20.12; };    # ns2 private IP address
    allow-transfer { none; };       # ns2 should NOT allow zone transfers

    forwarders {
        8.8.8.8;
        8.8.4.4;
    };

    dnssec-validation auto;
};

